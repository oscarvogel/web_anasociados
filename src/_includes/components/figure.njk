{# Imagen con placeholder de marca. Sin src: dibuja curvas de nivel y marca data-placeholder para reemplazar. #}
{% macro figure(src, alt, caption, classes) %}
{% if src %}
<figure class="{{ classes }}"><img src="{{ src }}" alt="{{ alt }}" loading="lazy" class="w-full h-full object-cover"></figure>
{% else %}
<figure class="placeholder {{ classes }}" data-placeholder {% if alt %}role="img" aria-label="{{ alt }}"{% else %}aria-hidden="true"{% endif %}>
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" fill="none" stroke="currentColor" stroke-opacity=".35" aria-hidden="true">
    <path d="M-20 240C60 200 90 250 170 210S300 150 420 200"/>
    <path d="M-20 200C60 160 100 215 175 175S305 110 420 160"/>
    <path d="M-20 160C70 120 110 180 180 140S310 70 420 120"/>
    <path d="M-20 120C75 80 120 145 185 105S315 30 420 80"/>
    <path d="M-20 80C80 45 130 110 190 70S320 -5 420 40"/>
  </svg>
  {% if caption %}<figcaption>{{ caption }}</figcaption>{% endif %}
</figure>
{% endif %}
{% endmacro %}
