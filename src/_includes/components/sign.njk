{# Señal de seguridad con la gramática ISO 7010 (forma y color por significado); casco: ícono Tabler (MIT). x/y opcionales para anidarla en otro SVG. #}
{% macro sign(kind, icon, size, x, y) %}
<svg class="sign" viewBox="0 0 48 48" width="{{ size or 56 }}" height="{{ size or 56 }}" {% if x is defined %}x="{{ x }}" y="{{ y }}"{% endif %} aria-hidden="true">
  {% if kind == "obligacion" %}
  <circle cx="24" cy="24" r="23" fill="var(--color-sign-azul)"/>
  <g transform="translate(10 10) scale(1.17)" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path fill="#fff" d="M12 4a9 9 0 0 1 5.656 16H6.344A9 9 0 0 1 12 4"/><path fill="#fff" d="M20 9h-8.8a1 1 0 0 0-.968 1.246q.76 3 3.268 4.254q3 1.5 7 1.5"/>
  </g>
  {% else %}
  <path d="M24 3 46 43H2Z" fill="var(--color-sign-amarillo)" stroke="var(--color-verde)" stroke-width="2.5" stroke-linejoin="round"/>
  <path d="M24 17v13M24 36h.01" fill="none" stroke="var(--color-verde)" stroke-width="3.2" stroke-linecap="round"/>
  {% endif %}
</svg>
{% endmacro %}
