{# Ilustraciones planas de artículos de seguridad (dibujadas para este sitio). Colores de EPP reales: casco blanco, guante amarillo, chaleco naranja, matafuego rojo. #}
{% macro epp(tipo, size) %}
<svg class="epp" viewBox="0 0 200 200" width="{{ size or 200 }}" height="{{ size or 200 }}" aria-hidden="true">
  <ellipse cx="100" cy="180" rx="66" ry="7" fill="#000" opacity=".22"/>
  {% if tipo == "casco" %}
  <path d="M28 124C28 74 60 40 100 40s72 34 72 84Z" fill="#EAE8DC"/>
  <path d="M66 50v74M134 50v74" stroke="#D6D1BE" stroke-width="7"/>
  <path d="M88 41h24v83H88Z" fill="#D6D1BE"/><path d="M94 41h12v83H94Z" fill="#F3F1E7"/>
  <path d="M28 110h144v14H28Z" fill="#A63E24"/>
  <path d="M14 124h172c0 10-10 18-22 18H36c-12 0-22-8-22-18Z" fill="#C9C4B0"/>
  <path d="M14 124h172c0 4-2 7-6 9H20c-4-2-6-5-6-9Z" fill="#B3AE9A"/>
  <path d="M44 84c6-18 20-30 38-34" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity=".7"/>
  {% elif tipo == "guantes" %}
  <rect x="62" y="40" width="19" height="70" rx="9.5" fill="#F2B705"/>
  <rect x="83" y="28" width="19" height="82" rx="9.5" fill="#F2B705"/>
  <rect x="104" y="34" width="19" height="76" rx="9.5" fill="#F2B705"/>
  <rect x="125" y="48" width="19" height="62" rx="9.5" fill="#F2B705"/>
  <rect x="140" y="98" width="19" height="54" rx="9.5" transform="rotate(-28 149 124)" fill="#D9A400"/>
  <path d="M62 104h82v52c0 6-4 10-10 10H72c-6 0-10-4-10-10Z" fill="#F2B705"/>
  <path d="M82 46v62M103 36v72M124 42v66" stroke="#C99700" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M62 96h82v14H62Z" fill="#2B2B2B"/>
  <rect x="64" y="152" width="78" height="26" rx="7" fill="#2B2B2B"/>
  {% elif tipo == "chaleco" %}
  <defs><clipPath id="clip-chaleco"><path d="M62 34 100 74l38-40 32 20-10 124H40L30 54Z"/></clipPath></defs>
  <path d="M62 34 100 74l38-40 32 20-10 124H40L30 54Z" fill="#EE7B22"/>
  <g clip-path="url(#clip-chaleco)" fill="#EAE8DC">
    <rect x="30" y="112" width="140" height="16"/><rect x="30" y="140" width="140" height="12"/>
    <rect x="58" y="30" width="14" height="150"/><rect x="128" y="30" width="14" height="150"/>
  </g>
  <path d="M80 34l20 40 20-40Z" fill="#B85414"/>
  <path d="M100 74v102" stroke="#B85414" stroke-width="4"/>
  {% elif tipo == "matafuego" %}
  <path d="M96 62C68 62 54 86 60 116" fill="none" stroke="#2B2B2B" stroke-width="7" stroke-linecap="round"/>
  <rect x="52" y="112" width="16" height="16" rx="3" fill="#2B2B2B"/>
  <rect x="68" y="76" width="64" height="104" rx="16" fill="#C4262E"/>
  <path d="M68 92a16 16 0 0 1 16-16h6v104h-6a16 16 0 0 1-16-16Z" fill="#9B1B22" opacity=".45"/>
  <rect x="88" y="54" width="24" height="26" rx="4" fill="#2B2B2B"/>
  <rect x="80" y="46" width="40" height="12" rx="4" fill="#2B2B2B"/>
  <path d="M118 50h32l-6 13h-26Z" fill="#2B2B2B"/>
  <rect x="78" y="108" width="44" height="44" rx="5" fill="#EAE8DC"/>
  <path d="M100 114c6 7 11 13 10 21a10 10 0 0 1-20 0c0-6 3-9 6-13 1 3 3 4 4 3 1-3 0-7 0-11Z" fill="#C4262E"/>
  {% else %}
  <path d="M22 100h-10v16h12" fill="none" stroke="#EAE8DC" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M178 100h10v16h-12" fill="none" stroke="#EAE8DC" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
  <rect x="22" y="76" width="72" height="56" rx="24" fill="#CFE6EE" fill-opacity=".5" stroke="#EAE8DC" stroke-width="7"/>
  <rect x="106" y="76" width="72" height="56" rx="24" fill="#CFE6EE" fill-opacity=".5" stroke="#EAE8DC" stroke-width="7"/>
  <path d="M94 96q6-8 12 0" fill="none" stroke="#EAE8DC" stroke-width="7" stroke-linecap="round"/>
  <path d="M38 94l22-9M122 94l22-9" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity=".75"/>
  {% endif %}
</svg>
{% endmacro %}

{# Cuadro de arte para tarjetas cuando aún no hay foto: fondo verde con el artículo de seguridad centrado #}
{% macro arte(tipo, clases, size) %}
<figure class="arte {{ clases }}" data-placeholder aria-hidden="true">{{ epp(tipo, size or 200) }}</figure>
{% endmacro %}
