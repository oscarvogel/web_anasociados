{# src/_includes/layouts/base.njk #}
<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5P6G7KP4XY"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-5P6G7KP4XY');
    </script>

    <meta charset="UTF-8">
    <link rel="icon" href="/assets/images/favicon.ico" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description | default('AN Asociados - Consultoría Almada Neri & Asociados, expertos en consultoría empresarial y soluciones estratégicas.') }}">
    <meta name="keywords" content="{{ keywords | default('consultoría, empresarial, soluciones estratégicas, Almada Neri, AN Asociados') }}">
    <meta name="author" content="{{ author | default('AN Asociados') }}">
    <meta property="og:title" content="{{ title }} | AN Asociados - Consultoría Almada Neri & Asociados">
    <meta property="og:description" content="{{ description | default('AN Asociados - Consultoría Almada Neri & Asociados, expertos en consultoría empresarial y soluciones estratégicas.') }}">
    <meta property="og:type" content="{{ og_type | default('website') }}">
    <meta property="og:url" content="{{ page.url }}">
    <meta property="og:image" content="{{ image | default('/assets/images/logo_almada_neri.jpg') }}">
    {% if date %}
    <meta property="article:published_time" content="{{ date }}">
    {% endif %}
    {% if author %}
    <meta property="article:author" content="{{ author }}">
    {% endif %}
    <link rel="canonical" href="{{ canonical | default(page.url) }}">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="{{ twitter_card | default('summary_large_image') }}">
    <meta name="twitter:title" content="{{ title }} | AN Asociados - Consultoría Almada Neri & Asociados">
    <meta name="twitter:description" content="{{ description | default('AN Asociados - Consultoría Almada Neri & Asociados, expertos en consultoría empresarial y soluciones estratégicas.') }}">
    <meta name="twitter:image" content="{{ image | default('/assets/images/logo_almada_neri.jpg') }}">

    <title>{{ title }} | AN Asociados - Consultoría Almada Neri & Asociados</title>
    <script src="https://cdn.tailwindcss.com" async></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    
    <!-- Preconnect para recursos externos -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <link  rel="stylesheet"  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "AN Asociados",
        "url": "https://www.anasociados.com.ar",
        "logo": "https://www.anasociados.com.ar/assets/images/logo_almada_neri.jpg",
        "description": "AN Asociados - Consultoría Almada Neri & Asociados, expertos en consultoría empresarial y soluciones estratégicas.",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "B° Industrial, calle Río Paraná S/N°",
            "addressLocality": "Puerto Esperanza Misiones.",
            "addressRegion": "MNES",
            "postalCode": "",
            "addressCountry": "AR"
        },
        "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+54 9 3757 67-7124",
            "contactType": "Customer Service"
        },
        "sameAs": [
            "https://www.facebook.com/anasociados",
            "https://www.twitter.com/anasociados",
            "https://www.linkedin.com/company/anasociados"
        ]
    }
    </script>
</head>
<body class="min-h-screen bg-gray-50">
    {% include "partials/header.njk" %}
    
    <main role="main">
        {{ content | safe }}
    </main>

    {%include "partials/whatsapp-button.njk" %}
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    
    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        AOS.init();
    </script>

</body>
</html>