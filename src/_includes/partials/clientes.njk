<section id="clientes" class="fusion f-arriba-verde f-abajo-verde bg-marfil-2 py-24 md:py-36" aria-labelledby="clientes-titulo">
  <div class="mx-auto max-w-[120rem] px-4 md:px-8">
    <p class="etiqueta">( 03 ) Clientes</p>
    <div class="mt-8 grid gap-8 md:grid-cols-12 md:items-end">
      <h2 id="clientes-titulo" class="text-[clamp(2.1rem,4.2vw,4rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-verde md:col-span-7">
        {{ clientes.tituloSeccion }}<br><span class="text-apagado">{{ clientes.lema }}</span>
      </h2>
      <p class="max-w-[46ch] text-[0.9375rem] leading-relaxed text-salvia md:col-span-4 md:col-start-9">{{ clientes.descripcion }}</p>
    </div>

    <p class="mt-10"><a href="/clientes_destacados/" class="link-under text-verde">Ver los trabajos con nuestros clientes →</a></p>

    <ul class="planilla mt-10">
      {% for c in clientes.clientes %}
      <li class="celda" data-reveal>
        <span class="mono celda-n" aria-hidden="true">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
        <img src="{{ c.logo }}" alt="{{ c.alt }}" loading="lazy" decoding="async">
      </li>
      {% endfor %}
      {# casillas vacías de la planilla: completan la última fila de 6 columnas (y por tanto de 2 y 3) #}
      {% for i in range((6 - (clientes.clientes | length) % 6) % 6) %}<li class="celda" aria-hidden="true"></li>{% endfor %}
    </ul>
  </div>
</section>
