<!-- src/_includes/partials/proyectos.njk -->
<section class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <h2 class="text-4xl font-bold text-[#2C4A1D] mb-4">{{ proyectos.tituloProyectos }}</h2>
      <p class="text-lg text-gray-600">{{ proyectos.subtituloProyectos }}</p>
    </div>

    <div class="max-w-6xl mx-auto grid md:grid-cols-2 grid-cols-1 gap-8">
      {% for proyecto in proyectos.proyectos %}
      <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow overflow-hidden">
        <img 
          src="{{ proyecto.imagen | url }}" 
          alt="{{ proyecto.titulo }}" 
          class="w-full h-48 object-cover"
          loading="lazy"
        >
        <div class="p-6">
          <h3 class="text-xl font-semibold text-[#3B5D30] mb-2">{{ proyecto.titulo }}</h3>
          <p class="text-gray-600">{{ proyecto.subtitulo }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>