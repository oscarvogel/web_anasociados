{% set flecha %}<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>{% endset %}
<header class="site-header" data-header>
  <div class="flex items-start justify-between gap-3">
    <a href="/" class="glass logo-tile" aria-label="AN Asociados, inicio">
      <img src="/assets/images/logo_almada_neri.png" alt="" class="h-6 w-auto">
      <span>AN Asociados</span>
    </a>

    <nav aria-label="Principal" class="glass pill-nav">
      {% for item in navigation %}
      <a href="{{ item.url }}" class="pill-item"><span class="pill-num">0{{ loop.index }}</span>{{ item.title }}</a>
      {% endfor %}
    </nav>

    <div class="flex items-center gap-3">
      <a href="{{ hero.portal.url }}" target="_blank" rel="noopener" class="portal-link hidden px-2 text-sm font-medium lg:block">{{ hero.portal.texto }}</a>
      <a href="{{ hero.contacto.url }}" class="btn-chip hidden lg:inline-flex"><span>{{ hero.contacto.texto }}</span><span>{{ flecha | safe }}</span></a>
      <button type="button" class="glass menu-button" data-menu-button aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M5 9h14M5 15h14"/></svg>
      </button>
    </div>
  </div>
</header>

<nav id="menu-movil" aria-label="Principal (móvil)" class="glass menu-panel" hidden>
  <ul>
    {% for item in navigation %}
    <li><a href="{{ item.url }}"><span class="pill-num">0{{ loop.index }}</span>{{ item.title }}</a></li>
    {% endfor %}
    <li><a href="{{ hero.contacto.url }}">{{ hero.contacto.texto }}</a></li>
    <li><a href="{{ hero.portal.url }}" target="_blank" rel="noopener">{{ hero.portal.texto }}</a></li>
  </ul>
</nav>
