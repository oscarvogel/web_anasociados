{% from "components/foto.njk" import foto %}
{% from "components/epp.njk" import arte %}
<section id="servicios" data-pin-h class="servicios on-dark bg-verde" aria-labelledby="servicios-titulo">
  <div class="mx-auto flex w-full max-w-[120rem] flex-col gap-8 px-4 md:flex-row md:items-end md:justify-between md:px-8">
    <div>
      <p class="etiqueta">( 02 ) Servicios</p>
      <h2 id="servicios-titulo" class="mt-6 text-[clamp(2.1rem,4.2vw,4rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-marfil">
        Servicios de consultoría<br><span class="text-apagado">con más de 13 años de experiencia.</span>
      </h2>
    </div>
    <div class="mono hidden text-right text-marfil/70 lg:block" aria-hidden="true">
      <p>Servicio <span class="text-tierra-clara" data-cuenta>01</span> / 0{{ servicios | length }}</p>
      <p class="mt-2">Desplázate para recorrer →</p>
      <span class="mt-3 block h-px w-48 bg-marfil/20"><span data-barra class="block h-px origin-left scale-x-0 bg-tierra-clara"></span></span>
    </div>
  </div>

  <ul class="track mt-12 md:mt-16" data-track>
    {% for s in servicios %}
    <li class="card-serv">
      <a href="/servicios/#{{ s.slug }}" class="group block">
        <div class="card-serv-media">
          {% if s.foto %}{{ foto(s.foto, s.fotoAlt, [560, 828, 1122], "(min-width: 1024px) 24vw, 78vw", "absolute inset-0 h-full w-full object-cover") }}{% else %}{{ arte(s.arte, "absolute inset-0 h-full w-full", 220) }}{% endif %}
        </div>
        <h3 class="mt-5 text-[clamp(1.25rem,1.5vw,1.5rem)] font-semibold leading-tight tracking-[-0.02em] text-marfil">{{ s.titulo }}</h3>
        <p class="mt-2 max-w-[34ch] text-[0.9375rem] leading-relaxed text-salvia-clara">{{ s.descripcion }}</p>
        <span class="link-under mt-4 inline-block text-marfil group-hover:text-tierra-clara">Ver servicio →</span>
      </a>
    </li>
    {% endfor %}
  </ul>
</section>
