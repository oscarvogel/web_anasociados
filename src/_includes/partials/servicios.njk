<section id="servicios" class="py-16 bg-white" data-aos="fade-up">
    <div class="container mx-auto px-6 max-w-6xl">
        <!-- Título y subtítulo -->
        <div class="mb-12 text-center max-w-2xl mx-auto">
            <h2 class="text-4xl font-extrabold text-gray-900 relative before:absolute before:-bottom-2 before:left-1/2 before:w-16 before:h-1 before:bg-gray-900 before:transform before:-translate-x-1/2">
                Servicios de Consultoría
            </h2>
            <p class="text-gray-500 mt-4 text-lg">
                Expertos en higiene, seguridad y medio ambiente con más de 13 años de experiencia.
            </p>
        </div>

        <!-- Contenido en dos columnas -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-12 items-center">
            <!-- Imagen -->
            <div class="relative rounded-xl overflow-hidden shadow-lg transform hover:scale-105 transition-transform" data-aos="fade-up">
                <img src="/assets/images/photo-1685432817839-fe6af105b128.avif" alt="Servicios de consultoría" class="w-full h-72 object-cover rounded-xl">
            </div>

            <!-- Texto con servicios -->
            <div class="space-y-6">
                {% for servicio in servicios %}
                <div class="space-y-2 border-l-4 border-gray-900 pl-4">
                    <h3 class="text-2xl font-semibold text-gray-900">{{ servicio.titulo }}</h3>
                    <p class="text-gray-600">{{ servicio.descripcion }}</p>
                </div>
                {% endfor %}

                <!-- Botón -->
                <div class="mt-6">
                    <a href="/servicios" class="inline-block px-6 py-3 bg-gray-900 text-white text-lg font-medium rounded-lg shadow-md hover:bg-gray-800 transition">
                        Ver todos los servicios
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
