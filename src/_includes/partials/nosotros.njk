{% set flecha %}<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>{% endset %}
<section id="nosotros" class="nosotros on-dark bg-verde pt-24 md:pt-36" aria-labelledby="nosotros-titulo">
  <div class="nosotros-foto" data-parallax aria-hidden="true"></div>
  <div class="nosotros-velo" aria-hidden="true"></div>

  <div class="mx-auto max-w-[120rem] px-4 md:px-8">
    <p class="etiqueta">{{ nosotros.etiqueta }}</p>
    <div class="mt-8 grid gap-10 md:grid-cols-12 md:items-end">
      <h2 id="nosotros-titulo" class="text-[clamp(2.1rem,4.6vw,4.5rem)] font-semibold leading-[1.04] tracking-[-0.03em] text-marfil md:col-span-7">
        {{ nosotros.titulo }}<br><span class="text-apagado">{{ nosotros.tituloApagado }}</span>
      </h2>
      <div class="md:col-span-4 md:col-start-9">
        <p class="max-w-[44ch] text-[0.9375rem] leading-relaxed text-salvia-clara">{{ nosotros.descripcion }}</p>
        <a href="{{ nosotros.boton.url }}" class="btn-chip mt-8"><span>{{ nosotros.boton.texto }}</span><span>{{ flecha | safe }}</span></a>
      </div>
    </div>

    <ul class="cifras mt-20 md:mt-28">
      {% for c in nosotros.cifras %}
      <li data-reveal>
        <p class="font-display text-[clamp(3rem,6vw,5.5rem)] font-semibold leading-none tracking-[-0.04em] text-marfil tabular"><span data-count="{{ c.valor }}">{{ c.valor }}</span><span class="text-tierra-clara">{{ c.sufijo }}</span></p>
        <p class="mt-3 max-w-[24ch] text-[0.8125rem] leading-snug text-salvia-clara">{{ c.descripcion }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>

  <div class="marquee mt-20 md:mt-28" aria-hidden="true">
    <div class="marquee-track" data-marquee>
      {% for copia in [1, 2] %}
      <div class="marquee-grupo">
        {% for c in clientes.clientes %}
        <span class="marquee-item">{{ c.alt }}</span><img src="/assets/images/logo_almada_neri.png" alt="" class="h-6 w-auto opacity-70">
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
