{% from "components/diagramas.njk" import plano, senalChecklist, parcelas %}
<section id="enfoque" data-cortina class="bg-marfil py-24 md:py-36" aria-labelledby="enfoque-frase">
  <div class="mx-auto max-w-[120rem] px-4 md:px-8">
    <p class="etiqueta">{{ enfoque.etiqueta }}</p>

    <h2 id="enfoque-frase" class="mt-8 max-w-[32ch] text-[clamp(1.9rem,4.1vw,4rem)] font-semibold leading-[1.08] tracking-[-0.03em] text-verde">
      <span data-fill>{{ enfoque.fraseA }} <span class="pildora" aria-hidden="true"></span> {{ enfoque.fraseB }}</span>
      <span class="text-apagado">{{ enfoque.fraseApagada }}</span>
    </h2>

    <div class="mt-16 grid gap-5 md:mt-24 md:grid-cols-3">
      {% for p in enfoque.paneles %}
      <article class="panel" data-reveal>
        <header class="panel-cab mono"><span>{{ p.indice }}</span><span>[ {{ p.etiqueta }} ]</span></header>
        <div class="panel-diagrama text-verde">
          {% if p.diagrama == "plano" %}{{ plano() }}{% elif p.diagrama == "senalChecklist" %}{{ senalChecklist() }}{% else %}{{ parcelas() }}{% endif %}
        </div>
        <h3 class="mt-8 text-[clamp(1.4rem,1.9vw,1.75rem)] font-semibold leading-tight tracking-[-0.02em] text-verde">{{ p.titulo }}</h3>
        <p class="mb-8 mt-3 max-w-[40ch] text-[0.9375rem] leading-relaxed text-salvia">{{ p.texto }}</p>
        <p class="panel-dato">
          <span class="font-display text-[2.5rem] font-semibold leading-none tracking-[-0.03em] text-verde tabular"><span data-count="{{ p.valor }}">{{ p.valor }}</span>{% if p.unidad == "+" %}+{% endif %}</span>
          <span class="text-[0.8125rem] leading-snug text-salvia">{% if p.unidad != "+" %}<span class="font-medium text-verde">{{ p.unidad }}</span> · {% endif %}{{ p.descripcion }}</span>
        </p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
