title: Servicios de Consultoría
layout: layouts/base.njk
tags: contacto
---

<!-- Sección Contacto -->
<section id="contacto" class="py-16 bg-[#F2F6EC]">
    <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-4xl font-bold text-[#2C4A1D] text-center mb-12">Contáctanos</h2>
            <p class="text-lg text-center text-[#2C4A1D] mb-8">¡Conversemos sobre las necesidades de su empresa! Estamos listos para acompañarlo en el camino hacia la excelencia.</p>
            
            <form 
                id="contactForm"
                class="space-y-6 bg-white p-8 rounded-lg shadow-lg"
                onsubmit="return handleSubmit(event)"
            >
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label for="nombre" class="block text-[#2C4A1D] mb-2">Nombre completo</label>
                        <input 
                            type="text" 
                            id="nombre" 
                            name="nombre" 
                            required
                            class="w-full px-4 py-2 border border-[#556B2F] rounded-lg focus:ring-2 focus:ring-[#3B5D30] focus:border-transparent"
                        >
                    </div>
                    
                    <div>
                        <label for="email" class="block text-[#2C4A1D] mb-2">Correo electrónico</label>
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            required
                            class="w-full px-4 py-2 border border-[#556B2F] rounded-lg focus:ring-2 focus:ring-[#3B5D30] focus:border-transparent"
                        >
                    </div>
                    
                    <div>
                        <label for="telefono" class="block text-[#2C4A1D] mb-2">Teléfono</label>
                        <input 
                            type="tel" 
                            id="telefono" 
                            name="telefono"
                            class="w-full px-4 py-2 border border-[#556B2F] rounded-lg focus:ring-2 focus:ring-[#3B5D30] focus:border-transparent"
                        >
                    </div>
                    
                    <div>
                        <label for="servicio" class="block text-[#2C4A1D] mb-2">Servicio de interés</label>
                        <select 
                            id="servicio" 
                            name="servicio"
                            class="w-full px-4 py-2 border border-[#556B2F] rounded-lg focus:ring-2 focus:ring-[#3B5D30] focus:border-transparent"
                        >
                            <option value="Higiene y Seguridad">Higiene y Seguridad</option>
                            <option value="Medio Ambiente">Medio Ambiente</option>
                            <option value="Sistemas de Gestión">Sistemas de Gestión</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label for="mensaje" class="block text-[#2C4A1D] mb-2">Mensaje</label>
                    <textarea 
                        id="mensaje" 
                        name="mensaje" 
                        rows="4"
                        required
                        class="w-full px-4 py-2 border border-[#556B2F] rounded-lg focus:ring-2 focus:ring-[#3B5D30] focus:border-transparent"
                    ></textarea>
                </div>

                <button 
                    type="submit"
                    class="w-full bg-[#556B2F] text-white px-8 py-3 rounded-lg text-lg hover:bg-[#3B5D30] transition-colors"
                >
                    Enviar Mensaje
                </button>

                <div id="form-messages" class="hidden p-4 rounded-lg text-center"></div>
            </form>
        </div>
    </div>
</section>

<script>
function handleSubmit(event) {
    event.preventDefault();
    
    const form = event.target;
    const formData = new FormData(form);
    const submitButton = form.querySelector('button[type="submit"]');
    const messages = document.getElementById('form-messages');
    
    // Validación básica
    if(!form.checkValidity()) {
        form.reportValidity();
        return false;
    }

    // Construir cuerpo del mensaje
    const body = `Nombre: ${formData.get('nombre')}%0D%0A
Email: ${formData.get('email')}%0D%0A
Teléfono: ${formData.get('telefono')}%0D%0A
Servicio: ${formData.get('servicio')}%0D%0A%0D%0A
Mensaje:%0D%0A${formData.get('mensaje')}`;

    // Abrir cliente de correo
    window.location.href = `mailto:almada_neri@hotmail.com?subject=Contacto desde sitio web&body=${body}`;

    // Feedback al usuario
    messages.classList.remove('hidden', 'bg-red-100', 'text-red-700');
    messages.classList.add('bg-green-100', 'text-green-700');
    messages.textContent = 'Se abrirá tu cliente de correo para enviar el mensaje';
    
    // Resetear formulario después de 5 segundos
    setTimeout(() => {
        form.reset();
        messages.classList.add('hidden');
    }, 5000);

    return false;
}
</script>

