---
title: Servicios de Consultoría
layout: layouts/base.njk
tags: servicios
---

<section class="py-16 bg-[#F2F6EC]" data-aos="fade-up">
    <h1 class="text-3xl font-bold text-center my-6">Servicios de Consultoría</h1>
    <p class="text-center text-gray-600 mb-8">Asesoría en higiene, seguridad y medio ambiente para alcanzar la excelencia operativa en su empresa.</p>

    <div class="container mx-auto px-4 md:px-20 lg:px-40 xl:px-60">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 justify-center">
        {% for servicio in servicios %}
            <div class="max-w-lg rounded-lg overflow-hidden p-4 text-center" data-aos="fade-up">
                <div class="shadow-lg rounded overflow-hidden">
                    <img class="w-full h-96 object-cover rounded-md" src="{{ servicio.imagen }}" alt="{{ servicio.titulo }}">
                    <div class="bg-white p-4 md:p-8 lg:p-12">
                        <h2 class="text-xl font-semibold mt-4">{{ servicio.titulo }}</h2>
                        <p class="font-light text-xl italic font-gray-800">
                            {{ servicio.descripcion }}
                        </p>
                    </div>
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
</section>


{%include "partials/alianzas.njk" %}

{%include "partials/footer.njk" %}

