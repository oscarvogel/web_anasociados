---
title: Clientes destacados
layout: layouts/pagina.njk
etiqueta: Trabajos con clientes
h1: Clientes destacados
bajada: Trabajamos con empresas líderes en sus sectores, brindando soluciones integrales en seguridad, medio ambiente y gestión de calidad.
---
<ul>
  {% for cliente in clientes_destacados %}
  <li class="trabajo-cliente" data-reveal>
    <div class="trabajo-marca">
      <span class="mono text-salvia">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
      {% if cliente.logo %}<img src="{{ cliente.logo }}" alt="Logo de {{ cliente.nombre }}" loading="lazy" decoding="async">{% endif %}
      <h2 class="font-display text-[1.375rem] font-semibold leading-tight tracking-[-0.02em] text-verde">{{ cliente.nombre }}</h2>
      {% if cliente.sector %}<p class="text-sm text-salvia">{{ cliente.sector }}</p>{% endif %}
    </div>
    <ul class="trabajo-lista">
      {% for trabajo in cliente.trabajos %}
      <li>
        <h3 class="font-display text-[1.125rem] font-semibold leading-snug tracking-[-0.01em] text-verde">{{ trabajo.titulo }}</h3>
        <p class="mt-2 max-w-[62ch] text-[0.9375rem] leading-relaxed text-salvia">{{ trabajo.descripcion }}</p>
      </li>
      {% endfor %}
    </ul>
  </li>
  {% endfor %}
</ul>
