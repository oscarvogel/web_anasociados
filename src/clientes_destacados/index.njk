---
title: Servicios de Consultoría
layout: layouts/base.njk
tags: clientes destacados
---

<section class="py-16 bg-gradient-to-b from-white to-gray-50">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <h2 class="text-4xl font-extrabold text-gray-800 mb-4">Clientes Destacados</h2>
      <div class="mx-auto w-24 h-1 bg-emerald-600 rounded-full mb-4"></div>
      <p class="text-lg text-gray-600">Trabajamos con empresas líderes en sus sectores, brindando soluciones integrales en seguridad, medio ambiente y gestión de calidad.</p>
    </div>

    <div class="grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-8">
      {% for cliente in clientes_destacados %}
      <article class="group bg-white rounded-2xl shadow-sm hover:shadow-xl transform hover:-translate-y-2 transition-all duration-300 overflow-hidden" aria-labelledby="cliente-{{ loop.index }}">
        <div class="p-6 flex flex-col h-full">
          <div class="flex items-center justify-center mb-4">
            {% if cliente.logo %}
              <div class="w-20 h-20 rounded-full bg-gray-100 flex items-center justify-center overflow-hidden ring-1 ring-gray-200 transition-transform duration-300 group-hover:scale-105 client-logo-wrap">
                <img class="client-logo client-logo-circle" src="{{ cliente.logo | url }}" alt="Logo {{ cliente.nombre }}" loading="lazy">
              </div>
            {% else %}
              <div class="w-20 h-20 rounded-full bg-emerald-50 flex items-center justify-center text-2xl font-semibold text-emerald-700">{{ cliente.nombre | slice(0,1) }}</div>
            {% endif %}
          </div>

          <header class="text-center mb-3">
            <h3 id="cliente-{{ loop.index }}" class="text-lg font-semibold text-gray-800">{{ cliente.nombre }}</h3>
            {% if cliente.sector %}
              <p class="mt-2 text-sm text-gray-500">{{ cliente.sector }}</p>
            {% endif %}
          </header>

          <div class="mt-3 flex-1">
            <ul class="space-y-2 text-gray-600 text-sm">
              {% for trabajo in cliente.trabajos %}
              <li class="flex">
                <span class="inline-flex items-center justify-center mr-3 w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 text-xs font-semibold">✓</span>
                <div>
                  <div class="font-medium text-emerald-800">{{ trabajo.titulo }}</div>
                  <div class="text-sm text-gray-600">{{ trabajo.descripcion }}</div>
                </div>
              </li>
              {% endfor %}
            </ul>
          </div>

          <div class="mt-6 text-center">
            <a href="/proyectos/" class="inline-block px-5 py-2 text-sm font-medium text-white bg-emerald-600 rounded-full hover:bg-emerald-700 transition-colors">Ver proyectos</a>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# Carousel compacto para muchos logos (se muestra si hay más de 6 clientes) #}
{% if clientes_destacados | length > 6 %}
<section class="py-12 bg-white">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-xl font-semibold text-gray-800">Más clientes</h3>
      <div class="space-x-2">
        <button class="clients-prev inline-flex items-center justify-center w-9 h-9 rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200" aria-label="Anterior">‹</button>
        <button class="clients-next inline-flex items-center justify-center w-9 h-9 rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200" aria-label="Siguiente">›</button>
      </div>
    </div>

    <div class="clients-carousel relative">
      <div class="clients-track flex gap-6 overflow-x-auto no-scrollbar py-2">
        {% for cliente in clientes_destacados %}
        <div class="flex-shrink-0 w-40 h-24 rounded-lg bg-gray-50 flex items-center justify-center p-4 client-logo-wrap">
          {% if cliente.logo %}
            <img class="client-logo" src="{{ cliente.logo | url }}" alt="{{ cliente.nombre }}" loading="lazy">
          {% else %}
            <span class="text-sm font-medium text-gray-700">{{ cliente.nombre }}</span>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      <div class="left-gradient pointer-events-none"></div>
      <div class="right-gradient pointer-events-none"></div>
    </div>
  </div>
</section>
<script src="/assets/js/clients-carousel.js" defer></script>
{% endif %}

{% include "partials/proyectos.njk" %}

{% include "partials/footer.njk" %}