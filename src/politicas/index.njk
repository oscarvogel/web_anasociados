---
title: Servicios de Consultoría
layout: layouts/base.njk
tags: politicas de privacidad
---

<section class="py-16 bg-gray-50">
  <div class="container mx-auto px-4 max-w-4xl">
    <article class="prose prose-lg text-gray-700">
      <header class="mb-12 text-center">
        <h1 class="text-4xl font-bold text-[#2C4A1D] mb-4">{{ politica.titulo }}</h1>
        <p class="text-lg text-gray-600">Última actualización: {{ politica.fecha }}</p>
      </header>

      {% for seccion in politica.secciones %}
      <section class="mb-8">
        <h2 class="text-2xl font-semibold text-[#3B5D30] mb-4">{{ seccion.titulo }}</h2>
        {% if seccion.lista %}
        <ul class="list-disc pl-6 space-y-2">
          {% for item in seccion.lista %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        {{ seccion.contenido | safe }}
      </section>
      {% endfor %}
    </article>
  </div>
</section>