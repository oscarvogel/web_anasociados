---
title: Política de privacidad
layout: layouts/pagina.njk
etiqueta: Legal
h1: Política de privacidad
eleventyComputed:
  bajada: "Última actualización: {{ politica.fecha }}"
prosa: true
---
{% for seccion in politica.secciones %}
<section>
  <h2>{{ seccion.titulo }}</h2>
  {% if seccion.lista %}
  <ul>
    {% for item in seccion.lista %}<li>{{ item }}</li>{% endfor %}
  </ul>
  {% endif %}
  {{ seccion.contenido | safe }}
</section>
{% endfor %}
